# Copy to .env for local work. Never commit .env. The app refuses to start when a
# required variable is missing or invalid, and names it.

# Runtime mode: development, test or production. Default: development.
NODE_ENV=development

# Address and port the web server listens on. Defaults: 0.0.0.0 and 4321.
HOST=0.0.0.0
PORT=4321

# REQUIRED. PostgreSQL connection URL. For quick local work without PostgreSQL, use
# pglite://memory (in-memory database, lost at restart, refused in production).
DATABASE_URL=postgres://christophe:change-me@localhost:5432/christophe

# Folder where uploaded images are stored. Default: ./uploads.
UPLOADS_DIR=./uploads

# Log level: fatal, error, warn, info, debug, trace or silent. Default: info.
LOG_LEVEL=info

# Public address of the site, without a path, for example https://christophe.art. Used in the
# canonical and hreflang links of every page. Set it in production; optional otherwise.
SITE_URL=http://localhost:4321

# Admin login limits: failed logins allowed per account (login email) and per IP address inside the
# window, and the window length in minutes. Defaults: 5, 20 and 15.
ADMIN_LOGIN_MAX_FAILURES_PER_ACCOUNT=5
ADMIN_LOGIN_MAX_FAILURES_PER_IP=20
ADMIN_LOGIN_WINDOW_MINUTES=15

# Admin sessions: minutes without activity before logout, and maximum hours since login.
# Defaults: 60 and 12.
ADMIN_SESSION_IDLE_MINUTES=60
ADMIN_SESSION_MAX_HOURS=12

# REQUIRED. Key that encrypts the second-factor secrets in the database: 32 random bytes in base64.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep it secret and back it up: without it, nobody can pass the code step and every second factor
# must be reset. Never commit the real value.
ADMIN_ENCRYPTION_KEY=REPLACE-WITH-A-GENERATED-KEY-WITH-44-CHARS=

# Second-factor codes: wrong codes allowed per account before it is locked, minutes the account stays
# locked, and minutes allowed to type the code after the password. Defaults: 5, 15 and 5.
ADMIN_CODE_MAX_FAILURES=5
ADMIN_CODE_LOCK_MINUTES=15
ADMIN_CODE_STEP_MINUTES=5

# Set to true when the site runs behind a reverse proxy that sets X-Forwarded-For, so the admin
# login limit and the activity log see the visitor's address. Default: false. Leave it false when
# the site is reachable directly: the header can then be forged.
TRUST_PROXY=false

# Serves the design showcase page at /dev/design: true or false. Default: false.
# Leave it off in production.
DEV_PAGES=true

# Used by compose.yml only: PostgreSQL password. REQUIRED to run the Docker stack.
POSTGRES_PASSWORD=change-me
