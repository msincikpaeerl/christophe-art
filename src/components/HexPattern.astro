---
// Line-drawn hexagon motif (from the hex nuts of the sculptures), as an SVG.
// Allowed in the header, the footer and loading states only; never behind an artwork.
// Each use on a page needs its own `id`.
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<svg class="hex-pattern" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <pattern id={id} width="24.249" height="42" patternUnits="userSpaceOnUse">
      <path
        d="M12.124 0 L24.249 7 V21 L12.124 28 L0 21 V7 Z M12.124 28 V42"
        fill="none"
        stroke="currentColor"
        stroke-width="1"
      ></path>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`}></rect>
</svg>

<style>
  .hex-pattern {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    pointer-events: none;
    color: var(--text-muted);
    opacity: var(--hex-opacity);
  }
</style>
